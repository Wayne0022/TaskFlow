# ============================================
# TaskFlow — Variables d'environnement
# ============================================
# Copie ce fichier en .env et remplis les valeurs
# Ne jamais commiter le fichier .env sur Git

# --- Base de données ---
DB_HOST=localhost
DB_NAME=taskflow
DB_USER=root
DB_PASS=

# --- API Claude (Anthropic) ---
# Obtenir une clé sur : https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-REMPLACE_PAR_TA_CLE

# --- Application ---
APP_URL=http://localhost/taskflow
APP_ENV=development     # development | production
