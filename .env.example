# ============================================
# TaskFlow — Variables d'environnement
# ============================================
# Copie ce fichier en .env et remplis les valeurs
# Ne jamais commiter le fichier .env sur Git

# --- Base de données ---
DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=taskflow
DB_USER=root
DB_PASS=root

# --- API Claude (Anthropic) ---
# Obtenir une clé sur : https://console.anthropic.com
CLAUDE_API_KEY=

# --- Application ---
APP_URL=http://localhost:8888/TaskFlow
APP_ENV=development     # development | production
